        Title="LED调试" Height="350" Width="525" Loaded="Window_Loaded">
    <Grid>
        <ComboBox x:Name="ddlPort" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="btnSend" Content="发送" HorizontalAlignment="Left" Margin="10,259,0,0" VerticalAlignment="Top" Width="75" Click="btnSend_Click"/>
        <TextBox x:Name="txtMessage" HorizontalAlignment="Left" Height="190" Margin="10,48,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="486"/>

    </Grid>
</Window>
